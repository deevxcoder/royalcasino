generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String?       @unique
  passwordHash String
  balance      Float         @default(1000.0)
  currency     String        @default("INR")
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  rounds       GameRound[]

  @@map("users")
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // DEPOSIT, WITHDRAWAL, BET, WIN
  amount       Float
  balanceAfter Float
  referenceId  String?
  description  String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("transactions")
}

model GameRound {
  id            String   @id @default(cuid())
  serialNumber  String   @unique // Idempotency key from NexxAPI callback
  gameId        Int?
  gameUid       String
  gameRound     String?
  memberAccount String   // userId
  user          User     @relation(fields: [memberAccount], references: [id], onDelete: Cascade)
  betAmount     Float    @default(0)
  winAmount     Float    @default(0)
  creditAmount  Float    // Authoritative balance after round
  gameName      String?
  rawPayload    String?
  createdAt     DateTime @default(now())

  @@index([memberAccount])
  @@map("game_rounds")
}

model SiteSetting {
  id           String   @id @default("default")
  siteName     String   @default("NEXX CASINO")
  siteSubtitle String   @default("Casino Royale")
  logoUrl      String?
  themeColor   String   @default("gold") // gold, emerald, ruby, purple, blue
  callbackUrl  String   @default("https://your-domain.com/api/callback")
  returnUrl    String   @default("https://your-domain.com/lobby")
  currency         String   @default("INR")
  enabledProviders String?  // JSON array of enabled brand_ids, e.g. "[57,45,49]". Null = all providers visible.
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}
